{
  "schema_version": 1,
  "document_id": "auth.login",
  "metadata": {
    "title": "MyBevy Login",
    "budget_profile": "mobile_baseline_v1"
  },
  "assets": {
    "login_background": {
      "kind": "image",
      "source": {
        "kind": "packaged",
        "path": "ui/images/login_stillwater_background.png"
      }
    }
  },
  "bindings": {
    "auth.login.login_name": {
      "scope": "local",
      "value_type": { "kind": "string" },
      "default": { "kind": "string", "value": "" },
      "missing": "use_default"
    },
    "auth.account.player_id": {
      "scope": "owner",
      "value_type": { "kind": "string" }
    },
    "auth.login.status": {
      "scope": "owner",
      "value_type": { "kind": "string" }
    },
    "auth.login.error_title": {
      "scope": "owner",
      "value_type": { "kind": "string" }
    },
    "auth.login.error_detail": {
      "scope": "owner",
      "value_type": { "kind": "string" }
    },
    "auth.login.error_visibility": {
      "scope": "owner",
      "value_type": { "kind": "visibility" }
    },
    "auth.login.notice_title": {
      "scope": "owner",
      "value_type": { "kind": "string" }
    },
    "auth.login.notice_detail": {
      "scope": "owner",
      "value_type": { "kind": "string" }
    },
    "auth.login.notice_visibility": {
      "scope": "owner",
      "value_type": { "kind": "visibility" }
    },
    "auth.login.request_pending": {
      "scope": "owner",
      "value_type": { "kind": "bool" }
    },
    "auth.login.disabled": {
      "scope": "owner",
      "value_type": { "kind": "bool" }
    },
    "auth.login.environment_locked": {
      "scope": "owner",
      "value_type": { "kind": "bool" }
    },
    "auth.login.environment": {
      "scope": "owner",
      "value_type": {
        "kind": "enum",
        "values": ["local", "production"]
      }
    }
  },
  "styles": {
    "login_panel": {
      "properties": {
        "background": {
          "kind": "solid",
          "color": { "kind": "literal", "value": "#071116ed" }
        },
        "border": {
          "width": { "kind": "literal", "value": 1.0 },
          "color": { "kind": "literal", "value": "#7e9c9799" }
        },
        "corner_radius": {
          "top_left": { "kind": "literal", "value": 6.0 },
          "top_right": { "kind": "literal", "value": 6.0 },
          "bottom_right": { "kind": "literal", "value": 6.0 },
          "bottom_left": { "kind": "literal", "value": 6.0 }
        },
        "shadows": [
          {
            "color": { "kind": "literal", "value": "#00000099" },
            "x_offset": { "kind": "literal", "value": 0.0 },
            "y_offset": { "kind": "literal", "value": 8.0 },
            "blur": { "kind": "literal", "value": 22.0 },
            "spread": { "kind": "literal", "value": 0.0 }
          }
        ]
      }
    },
    "login_rule": {
      "properties": {
        "background": {
          "kind": "solid",
          "color": { "kind": "literal", "value": "#8da9a566" }
        }
      }
    },
    "login_error": {
      "properties": {
        "border": {
          "width": { "kind": "literal", "value": 1.0 },
          "color": { "kind": "literal", "value": "#d45a61cc" }
        }
      }
    },
    "login_notice": {
      "properties": {
        "border": {
          "width": { "kind": "literal", "value": 1.0 },
          "color": { "kind": "literal", "value": "#7e9c9780" }
        }
      }
    }
  },
  "root": {
    "type": "container",
    "id": "login.root",
    "layout": {
      "width": { "percent": 100.0 },
      "height": { "percent": 100.0 },
      "min_width": { "px": 280.0 },
      "min_height": { "px": 240.0 }
    },
    "style": {
      "inline": {
        "background": {
          "kind": "solid",
          "color": { "kind": "literal", "value": "#05090d" }
        }
      }
    },
    "children": [
      {
        "type": "image",
        "id": "login.background",
        "asset": "login_background",
        "presentation": {
          "kind": "fit",
          "fit": "cover",
          "focus": { "x": 0.5, "y": 0.5 }
        },
        "layout": {
          "position": {
            "absolute": {
              "left": { "px": 0.0 },
              "top": { "px": 0.0 }
            }
          },
          "width": { "percent": 100.0 },
          "height": { "percent": 100.0 },
          "z_index": 0
        }
      },
      {
        "type": "container",
        "id": "login.veil",
        "layout": {
          "position": {
            "absolute": {
              "left": { "px": 0.0 },
              "top": { "px": 0.0 }
            }
          },
          "width": { "percent": 100.0 },
          "height": { "percent": 100.0 },
          "z_index": 1
        },
        "style": {
          "inline": {
            "background": {
              "kind": "solid",
              "color": { "kind": "literal", "value": "#02060873" }
            }
          }
        }
      },
      {
        "type": "scroll",
        "id": "login.scroll",
        "block_lower": true,
        "max_height": 1200.0,
        "layout": {
          "position": {
            "absolute": {
              "left": { "px": 0.0 },
              "top": { "px": 0.0 }
            }
          },
          "width": { "percent": 100.0 },
          "height": { "percent": 100.0 },
          "padding": { "all": { "px": 20.0 } },
          "align_items": "center",
          "justify_content": "center",
          "z_index": 2
        },
        "component": {
          "children": [
            {
              "type": "container",
              "id": "login.panel",
              "layout": {
                "width": { "percent": 100.0 },
                "max_width": { "px": 384.0 },
                "min_width": { "px": 320.0 },
                "padding": { "all": { "px": 24.0 } },
                "gap": { "px": 14.0 },
                "direction": "column",
                "flex_shrink": 0.0
              },
              "style": { "component": "login_panel" },
              "children": [
                {
                  "type": "text",
                  "id": "login.title",
                  "content": { "literal": "STILLWATER" },
                  "style": { "text_role": "title" }
                },
                {
                  "type": "text",
                  "id": "login.subtitle",
                  "content": { "literal": "Account Login" },
                  "style": { "text_role": "caption" }
                },
                {
                  "type": "spacer",
                  "id": "login.rule",
                  "layout": {
                    "width": { "percent": 100.0 },
                    "height": { "px": 1.0 }
                  },
                  "style": { "component": "login_rule" }
                },
                {
                  "type": "container",
                  "id": "login.main",
                  "layout": {
                    "width": { "percent": 100.0 },
                    "direction": "column",
                    "gap": { "px": 12.0 }
                  },
                  "children": [
                    {
                      "type": "container",
                      "id": "login.credentials",
                      "layout": {
                        "width": { "percent": 100.0 },
                        "direction": "column",
                        "gap": { "px": 10.0 }
                      },
                      "children": [
                        {
                          "type": "container",
                          "id": "login.environment_group",
                          "layout": {
                            "width": { "percent": 100.0 },
                            "direction": "column",
                            "gap": { "px": 4.0 }
                          },
                          "children": [
                            {
                              "type": "segmented",
                              "id": "login.environment",
                              "selected": "local",
                              "options": [
                                { "value": "local", "label": { "literal": "Local" } },
                                { "value": "production", "label": { "literal": "Production" } }
                              ],
                              "on_change": {
                                "action": "auth.switch_environment",
                                "params": {
                                  "environment": { "kind": "current_control_value" }
                                }
                              },
                              "layout": {
                                "width": { "percent": 100.0 },
                                "direction": "row"
                              },
                              "component": {
                                "bindings": {
                                  "disabled": "auth.login.environment_locked",
                                  "value": {
                                    "binding_path": "auth.login.environment",
                                    "direction": "one_way"
                                  }
                                },
                                "slots": {
                                  "label": {
                                    "kind": "text",
                                    "content": { "literal": "Server" }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "type": "text_input",
                          "id": "login.account",
                          "value": "",
                          "max_chars": 256,
                          "component": {
                            "bindings": {
                              "disabled": "auth.login.disabled",
                              "value": {
                                "binding_path": "auth.login.login_name",
                                "direction": "two_way"
                              }
                            },
                            "slots": {
                              "label": {
                                "kind": "text",
                                "content": { "literal": "Account" }
                              },
                              "placeholder": {
                                "kind": "text",
                                "content": { "literal": "Enter account" }
                              }
                            }
                          }
                        },
                        {
                          "type": "text_input",
                          "id": "login.password",
                          "value": "",
                          "security": "sensitive",
                          "max_chars": 4096,
                          "component": {
                            "bindings": {
                              "disabled": "auth.login.disabled"
                            },
                            "slots": {
                              "label": {
                                "kind": "text",
                                "content": { "literal": "Password" }
                              },
                              "placeholder": {
                                "kind": "text",
                                "content": { "literal": "Enter password" }
                              }
                            }
                          }
                        },
                        {
                          "type": "container",
                          "id": "login.actions",
                          "layout": {
                            "width": { "percent": 100.0 },
                            "direction": "row",
                            "gap": { "px": 10.0 },
                            "wrap": "wrap"
                          },
                          "children": [
                            {
                              "type": "button",
                              "id": "login.submit",
                              "variant": "primary",
                              "label": { "literal": "Login" },
                              "on_click": { "action": "auth.account_login" },
                              "layout": {
                                "flex_grow": 1.0,
                                "min_width": { "px": 116.0 }
                              },
                              "component": {
                                "bindings": {
                                  "disabled": "auth.login.disabled",
                                  "loading": "auth.login.request_pending"
                                }
                              }
                            },
                            {
                              "type": "button",
                              "id": "login.guest",
                              "variant": "secondary",
                              "label": { "literal": "Guest" },
                              "on_click": { "action": "auth.guest_login" },
                              "layout": {
                                "flex_grow": 1.0,
                                "min_width": { "px": 116.0 }
                              },
                              "component": {
                                "bindings": {
                                  "disabled": "auth.login.disabled",
                                  "loading": "auth.login.request_pending"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "container",
                      "id": "login.feedback",
                      "layout": {
                        "width": { "percent": 100.0 },
                        "direction": "column",
                        "gap": { "px": 8.0 }
                      },
                      "children": [
                        {
                          "type": "text",
                          "id": "login.status",
                          "content": {
                            "binding_path": "auth.login.status",
                            "fallback": "Not logged in"
                          },
                          "style": { "text_role": "caption" }
                        },
                        {
                          "type": "container",
                          "id": "login.error",
                          "layout": {
                            "width": { "percent": 100.0 },
                            "direction": "column",
                            "gap": { "px": 4.0 },
                            "padding": { "all": { "px": 10.0 } },
                            "border": { "all": { "px": 1.0 } }
                          },
                          "style": {
                            "component": "login_error",
                            "bindings": {
                              "visibility": "auth.login.error_visibility"
                            }
                          },
                          "children": [
                            {
                              "type": "text",
                              "id": "login.error_title",
                              "content": {
                                "binding_path": "auth.login.error_title",
                                "fallback": ""
                              },
                              "style": { "text_role": "body" }
                            },
                            {
                              "type": "text",
                              "id": "login.error_detail",
                              "content": {
                                "binding_path": "auth.login.error_detail",
                                "fallback": ""
                              },
                              "style": { "text_role": "caption" }
                            }
                          ]
                        },
                        {
                          "type": "container",
                          "id": "login.notice",
                          "layout": {
                            "width": { "percent": 100.0 },
                            "direction": "column",
                            "gap": { "px": 4.0 },
                            "padding": { "all": { "px": 10.0 } },
                            "border": { "all": { "px": 1.0 } }
                          },
                          "style": {
                            "component": "login_notice",
                            "bindings": {
                              "visibility": "auth.login.notice_visibility"
                            }
                          },
                          "children": [
                            {
                              "type": "text",
                              "id": "login.notice_title",
                              "content": {
                                "binding_path": "auth.login.notice_title",
                                "fallback": ""
                              },
                              "style": { "text_role": "body" }
                            },
                            {
                              "type": "text",
                              "id": "login.notice_detail",
                              "content": {
                                "binding_path": "auth.login.notice_detail",
                                "fallback": ""
                              },
                              "style": { "text_role": "caption" }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "states": [],
  "responsive": [
    {
      "id": "short_landscape",
      "priority": 100,
      "when": {
        "height_class": "short",
        "orientation": "landscape"
      },
      "overrides": [
        {
          "node_id": "login.scroll",
          "set": {
            "layout": {
              "padding": { "all": { "px": 10.0 } },
              "justify_content": "start"
            }
          }
        },
        {
          "node_id": "login.panel",
          "set": {
            "layout": {
              "max_width": { "px": 760.0 },
              "padding": { "all": { "px": 16.0 } },
              "gap": { "px": 9.0 }
            }
          }
        },
        {
          "node_id": "login.main",
          "set": {
            "layout": {
              "direction": "row",
              "gap": { "px": 16.0 },
              "align_items": "start"
            }
          }
        },
        {
          "node_id": "login.credentials",
          "set": {
            "layout": {
              "width": { "percent": 62.0 },
              "direction": "row",
              "wrap": "wrap"
            }
          }
        },
        {
          "node_id": "login.environment_group",
          "set": {
            "layout": {
              "width": { "percent": 100.0 }
            }
          }
        },
        {
          "node_id": "login.account",
          "set": {
            "layout": {
              "width": { "percent": 48.0 },
              "min_width": { "px": 0.0 }
            }
          }
        },
        {
          "node_id": "login.password",
          "set": {
            "layout": {
              "width": { "percent": 48.0 },
              "min_width": { "px": 0.0 }
            }
          }
        },
        {
          "node_id": "login.actions",
          "set": {
            "layout": {
              "width": { "percent": 100.0 }
            }
          }
        },
        {
          "node_id": "login.feedback",
          "set": {
            "layout": {
              "width": { "percent": 38.0 }
            }
          }
        }
      ]
    },
    {
      "id": "compact_width",
      "priority": 50,
      "when": { "width_class": "compact" },
      "overrides": [
        {
          "node_id": "login.scroll",
          "set": {
            "layout": { "padding": { "all": { "px": 10.0 } } }
          }
        },
        {
          "node_id": "login.panel",
          "set": {
            "layout": {
              "min_width": { "px": 0.0 },
              "padding": { "all": { "px": 16.0 } }
            }
          }
        }
      ]
    }
  ]
}
