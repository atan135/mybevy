{
  "schema_version": "fangyuan-generation-task/v1",
  "task_id": "qingyu-mechanism-tower-fixture",
  "stable_id": "qingyu_mechanism_tower_fixture",
  "object_purpose": "scene_decoration",
  "prompt": "Create a Qingyu mechanism tower scene decoration with a masonry stone base, a metal frame, and a ceramic cyan-jade core. Keep it static, solid, and assembled from rectilinear tower parts with a few rounded core nodes; no gameplay effects.",
  "budget": {
    "max_primitives": 150,
    "bounds": {
      "width": 10.0,
      "depth": 10.0,
      "height": 16.0
    },
    "max_primitive_volume": 64.0,
    "max_total_volume": 384.0
  },
  "allowed": {
    "primitive_kinds": ["cube", "sphere"],
    "roles": ["structure", "core", "boundary", "decoration"]
  },
  "material_budget": {
    "max_surface_presets": 3,
    "max_material_profiles": 4,
    "allow_catalog_suggested_noise": true,
    "max_catalog_noise_suggestions_per_preset": 1,
    "allow_arbitrary_overrides": false
  },
  "forbidden_features": [
    "absolute_path",
    "url",
    "credential",
    "network_call",
    "script",
    "shader",
    "atlas_uv",
    "atlas_tile_index",
    "noise_tile_id",
    "noise_strength",
    "arbitrary_pbr_override",
    "material_binding_table",
    "rotation",
    "free_mesh",
    "gameplay_override"
  ],
  "additional_forbidden_features": [
    "transparent",
    "emissive",
    "special_surface",
    "water_surface",
    "sky_surface",
    "lava_surface",
    "triplanar_required"
  ]
}
