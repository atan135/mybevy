{
  "title": "Fangyuan local generation task v1",
  "description": "Strict, provider-neutral input shape for one local Fangyuan authoring object. This descriptor has no external references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "stable_id",
    "object_purpose",
    "prompt",
    "budget",
    "allowed",
    "material_budget",
    "forbidden_features"
  ],
  "properties": {
    "schema_version": {
      "const": "fangyuan-generation-task/v1"
    },
    "task_id": {
      "$ref": "#/$defs/task_id"
    },
    "stable_id": {
      "$ref": "#/$defs/stable_id"
    },
    "object_purpose": {
      "enum": [
        "avatar_appearance",
        "home_decoration",
        "equipment_appearance",
        "skill_visual",
        "npc_appearance",
        "scene_decoration"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_primitives",
        "bounds",
        "max_primitive_volume",
        "max_total_volume"
      ],
      "properties": {
        "max_primitives": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "depth", "height"],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            }
          }
        },
        "max_primitive_volume": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        },
        "max_total_volume": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 32768
        }
      }
    },
    "allowed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_kinds", "roles"],
      "properties": {
        "primitive_kinds": {
          "const": ["cube", "sphere"]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "structure",
              "core",
              "boundary",
              "warning",
              "trail",
              "impact",
              "decoration",
              "socket",
              "archive"
            ]
          }
        }
      }
    },
    "material_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_surface_presets",
        "max_material_profiles",
        "allow_catalog_suggested_noise",
        "max_catalog_noise_suggestions_per_preset",
        "allow_arbitrary_overrides"
      ],
      "properties": {
        "max_surface_presets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_material_profiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "allow_catalog_suggested_noise": {
          "type": "boolean"
        },
        "max_catalog_noise_suggestions_per_preset": {
          "const": 1
        },
        "allow_arbitrary_overrides": {
          "const": false
        }
      }
    },
    "forbidden_features": {
      "const": [
        "absolute_path",
        "url",
        "credential",
        "network_call",
        "script",
        "shader",
        "atlas_uv",
        "atlas_tile_index",
        "noise_tile_id",
        "noise_strength",
        "arbitrary_pbr_override",
        "material_binding_table",
        "rotation",
        "free_mesh",
        "gameplay_override"
      ]
    },
    "additional_forbidden_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "transparent",
          "emissive",
          "special_surface",
          "water_surface",
          "sky_surface",
          "lava_surface",
          "triplanar_required"
        ]
      }
    }
  },
  "$defs": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
